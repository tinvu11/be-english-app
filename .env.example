# App
APP_NAME=go-clean-template
APP_VERSION=1.0.0
# HTTP settings
HTTP_PORT=8080
HTTP_USE_PREFORK_MODE=false
# Logger
LOG_LEVEL=debug
# PG
PG_POOL_MAX=2
PG_URL=postgres://user:myAwEsOm3pa55%40w0rd@127.0.0.1:5433/db
# Metrics
METRICS_ENABLED=true
# Swagger
SWAGGER_ENABLED=true
# Tracing
TRACING_ENABLED=false
TRACING_OTLP_ENDPOINT=localhost:4317
TRACING_OTLP_INSECURE=true
TRACING_SAMPLE_RATE=1.0
# Firebase Authentication
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json
# Local yt-dlp process (downloads and normalizes YouTube audio with FFmpeg)
YTDLP_BINARY_PATH=yt-dlp
YTDLP_TIMEOUT_SECONDS=300
YTDLP_MAX_FILE_MB=100
# Start the PO Token provider on localhost:4416 before running make run.
YTDLP_POT_SERVER_URL=http://127.0.0.1:4416
# Groq Whisper transcription
GROQ_BASE_URL=https://api.groq.com
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_SECONDS=300
# Azure Speech pronunciation assessment (resource endpoint, e.g. https://my-speech.cognitiveservices.azure.com)
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_TIMEOUT_SECONDS=30
# DeepSeek caption translation (leave API key empty to disable translation)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_BATCH_ITEMS=50
DEEPSEEK_MAX_RETRIES=2

# Daily free-account feature quotas. Premium accounts are unlimited.
# Quota windows reset at 00:00 UTC. Set a value to 0 to disable the feature for free accounts.
QUOTA_YOUTUBE_IMPORT_DAILY=3
QUOTA_SHADOWING_ASSESSMENT_DAILY=5

# In-App Purchase. Keep disabled until both store credentials are provisioned.
IAP_ENABLED=false
APPLE_IAP_ENABLED=false
IAP_RESTORE_POLICY=block
IAP_TIMEOUT_SECONDS=15
# Production: https://api.storekit.apple.com
# Sandbox:    https://api.storekit-sandbox.apple.com
APPLE_IAP_BASE_URL=https://api.storekit-sandbox.itunes.apple.com
APPLE_IAP_ISSUER_ID=00000000-0000-0000-0000-000000000000
APPLE_IAP_KEY_ID=ABC1234567
APPLE_IAP_BUNDLE_ID=com.tinvu.languageapp
# Exact numeric App Store app ID; required in Production.
APPLE_IAP_APP_ID=1234567890
APPLE_IAP_ENVIRONMENT=Sandbox
APPLE_IAP_PRIVATE_KEY_PATH=secrets/dummy.p8
APPLE_IAP_ROOT_CA_PATH=secrets/dummy.cer
# PEM bundle containing the Apple Root CA certificate(s) used to pin JWS trust.
APPLE_IAP_ROOT_CA_PATH=secrets/dummy.cer
GOOGLE_PLAY_PACKAGE_NAME=com.example.app
GOOGLE_PLAY_CREDENTIALS_FILE=secrets/google-play-service-account.json
