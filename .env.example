# App
APP_NAME=go-clean-template
APP_VERSION=1.0.0
# HTTP settings
HTTP_PORT=8080
HTTP_USE_PREFORK_MODE=false
# Logger
LOG_LEVEL=debug
# PG
PG_POOL_MAX=2
PG_URL=postgres://user:myAwEsOm3pa55%40w0rd@127.0.0.1:5433/db
# Metrics
METRICS_ENABLED=true
# Swagger
SWAGGER_ENABLED=true
# Tracing
TRACING_ENABLED=true
TRACING_OTLP_ENDPOINT=localhost:4317
TRACING_OTLP_INSECURE=true
TRACING_SAMPLE_RATE=1.0
# Firebase Authentication
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json
# yt-dlp service (downloads and normalizes YouTube audio with FFmpeg)
YTDLP_BASE_URL=http://localhost:8081
YTDLP_TIMEOUT_SECONDS=300
# Groq Whisper transcription
GROQ_BASE_URL=https://api.groq.com
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_SECONDS=300
# Azure Speech pronunciation assessment (resource endpoint, e.g. https://my-speech.cognitiveservices.azure.com)
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_TIMEOUT_SECONDS=30
# DeepSeek caption translation (leave API key empty to disable translation)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_BATCH_ITEMS=50
DEEPSEEK_MAX_RETRIES=2
